# Database
DATABASE_URL=postgresql://nutrition_user:nutrition_password@localhost:5432/nutrition_app
REDIS_URL=redis://localhost:6379

# API Keys (users will enter their own in the app)
# These are optional for server-side usage
DEFAULT_TAVILY_API_KEY=
DEFAULT_OPENAI_API_KEY=
DEFAULT_ANTHROPIC_API_KEY=
DEFAULT_DEEPSEEK_API_KEY=

# Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-encryption-key-here

# App
JWT_SECRET=your-jwt-secret-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
PORT=8000
ENVIRONMENT=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
